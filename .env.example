# Fixed portfolio allocation. Changes require coordinator approval.
PROJECT_SLUG=lineage-lifeboat
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8101
APP_PUBLIC_URL=http://localhost:8101
APP_STATE_DIR=.data/lineage-lifeboat

# Shared DataHub contract. Keep DATAHUB_TOKEN secret and outside Git.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_MCP_URL=http://localhost:8000/mcp
DATAHUB_TOKEN=
DATAHUB_DOMAIN=Demo / Lineage Lifeboat
DATAHUB_PROJECT_TAG=project-lineage-lifeboat
DATAHUB_URN_PREFIX=lifeboat.

DEMO_FIXTURE_ROOT=demo/fixtures/lineage-lifeboat

# Deployment mounts APP_STATE_DIR at:
# /var/lib/datahub-hackathon/lineage-lifeboat